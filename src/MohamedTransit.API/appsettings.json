{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=MohamedTransitDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },

  "AllowedHosts": "*",
  "JwtSettings": {
    "SigningKey": "Replace_With_A_Strong_32+_char_Key_ChangeInProd!",
    "Issuer": "MohamedTransitApp",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7
  },

  "Settings": {
    "EmailSettings": {
      "MailServer": "smtp.gmail.com",
      "MailPort": 587,
      "SenderName": "Mohamed Transit System",
      "Sender": "your-email@gmail.com",
      "Password": "your-app-password"
    },
    "AzureStorageConfig": {
      "AccountName": "your_azure_account_name",
      "ImageContainer": "shipment-images",
      "AccountKey": "your_azure_storage_account_key"
    }
  }
}
